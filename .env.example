# App auth
# Must be a long random string. Iron Session requires at least 32 characters.
SESSION_SECRET=replace-with-a-long-random-secret
REPORT_PASSWORD=replace-with-staff-login-password

# Public app URL used to build the Lightspeed OAuth callback URL.
# Example: https://flow-report.example.com
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Lightspeed Retail
# Domain prefix from https://{prefix}.retail.lightspeed.app
LS_DOMAIN_PREFIX=your-store-prefix
LS_CLIENT_ID=replace-with-lightspeed-oauth-client-id
LS_CLIENT_SECRET=replace-with-lightspeed-oauth-client-secret

# Use either LS_REFRESH_TOKEN (preferred, refreshes through KV) or LS_ACCESS_TOKEN
# (static-token fallback for simpler/local setups).
LS_REFRESH_TOKEN=replace-with-lightspeed-refresh-token
LS_ACCESS_TOKEN=

# Vercel KV / Upstash Redis
# Vercel usually injects these automatically in hosted environments.
KV_REST_API_URL=https://your-kv-url.upstash.io
KV_REST_API_TOKEN=replace-with-kv-rest-api-token
KV_REST_API_READ_ONLY_TOKEN=replace-with-kv-read-only-token
KV_URL=rediss://default:password@your-kv-host.upstash.io:6379

# Cron / GitHub Actions bearer token for scan, cache, validation, and delta routes.
CRON_SECRET=replace-with-shared-cron-secret

# Optional feature flags. Any value other than "0" enables the cache.
ENABLE_SALES_STORE=1
ENABLE_CONSIGN_STORE=1
ENABLE_BULK_INVENTORY=1

# Vercel provides these automatically. They are shown here for local scripts that
# need to call the deployed app from cron/orchestration code.
VERCEL_URL=
VERCEL_PROJECT_PRODUCTION_URL=
